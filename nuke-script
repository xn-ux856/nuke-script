-- Roblox 鯖全体ランダムNUKEスクリプト（クールダウン付き）
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")

local OWNER_ID = 自分のUserIdの数字  -- ←ここだけ自分のRoblox UserIdに変えて！（プロフィールから数字だけコピー）
local COOLDOWN_TIME = 300  -- 5分クールダウン（秒）
local cooldowns = {}

local function shuffleTable(t)
    for i = #t, 2, -1 do
        local j = math.random(i)
        t[i], t[j] = t[j], t[i]
    end
    return t
end

local function rocketNuke(targetPlayer)
    local character = targetPlayer.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local hum = character:FindFirstChild("Humanoid")
    if not hrp or not hum then return end
    
    local offset = Vector3.new(math.random(-100,100), math.random(80,150), math.random(-100,100))
    local startPos = hrp.Position + offset
    local rocketDir = (hrp.Position - startPos).Unit
    
    local rocket = Instance.new("Part")
    rocket.Name = "NukeRocket"
    rocket.Size = Vector3.new(2, 2, 6)
    rocket.Material = Enum.Material.Neon
    rocket.Color = Color3.fromRGB(255, 50, 0)
    rocket.CFrame = CFrame.lookAt(startPos, hrp.Position)
    rocket.Parent = workspace
    
    local bv = Instance.new("BodyVelocity")
    bv.Velocity = rocketDir * 400
    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bv.Parent = rocket
    
    local touchedConn
    touchedConn = rocket.Touched:Connect(function(hit)
        if hit.Parent == character then
            hum.PlatformStand = true
            hum.Sit = true
            
            hrp.AssemblyLinearVelocity = Vector3.new(
                math.random(-1500, 1500),
                math.random(1000, 2000),
                math.random(-1500, 1500)
            )
            
            local explosion = Instance.new("Explosion")
            explosion.Position = rocket.Position
            explosion.BlastRadius = 60
            explosion.BlastPressure = 0
            explosion.Parent = workspace
            
            rocket:Destroy()
            touchedConn:Disconnect()
        end
    end)
    
    Debris:AddItem(rocket, 15)
end

Players.PlayerAdded:Connect(function(player)
    player.Chatted:Connect(function(msg)
        if msg:lower() == "/nuke" and player.UserId == OWNER_ID then
            local now = tick()
            if cooldowns[player] and now - cooldowns[player] < COOLDOWN_TIME then
                local remaining = math.ceil(COOLDOWN_TIME - (now - cooldowns[player]))
                player:Kick("クールダウン中！あと" .. remaining .. "秒待て")
                return
            end
            
            cooldowns[player] = now
            print(player.Name .. " がNUKE発動！！💥")
            
            local targets = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player and p.Character then
                    table.insert(targets, p)
                end
            end
            
            targets = shuffleTable(targets)
            
            for i, target in ipairs(targets) do
                task.spawn(function()
                    wait(math.random(0, 2))
                    rocketNuke(target)
                end)
            end
        end
    end)
end)
